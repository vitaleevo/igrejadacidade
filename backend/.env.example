APP_ENV=development
DATABASE_URL=sqlite:///./rccg.db
# Para produção Postgres:
# APP_ENV=production
# DATABASE_URL=postgresql://user:password@db:5432/rccg
SECRET_KEY=change-me-super-secret
ADMIN_API_KEY=generate-a-long-random-value-before-production
CORS_ORIGINS=["http://localhost:3000","https://igrejadacidadeluanda.org","https://testimonies.igrejadacidadeluanda.org"]
# Produção:
# STORAGE_BACKEND=local
# S3_BUCKET=
# S3_ENDPOINT_URL=
# REDIS_URL=redis://redis:6379/0
# TURNSTILE_SECRET_KEY=
# MAX_REQUEST_BODY_KB=56320
# Email cPanel (preencher SÓ no servidor, nunca commitar):
# SMTP_HOST=ws101.angoweb.net
# SMTP_PORT=465
# SMTP_USER=testimonies@igrejadacidadeluanda.org
# SMTP_PASSWORD=<definir-no-servidor>
# SMTP_FROM=testimonies@igrejadacidadeluanda.org
# NOTIFY_EMAIL=testimonies@igrejadacidadeluanda.org
# FRONTEND_ADMIN_URL=https://igrejadacidadeluanda.org/admin
